rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "daniyalqasmi5327@gmail.com" ||
        request.auth.token.email == "admin@emeraldhaya.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() <= 150 &&
                       incoming().phone is string &&
                       incoming().phone.size() <= 40 &&
                       incoming().total is number;
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() <= 100 &&
                       incoming().comment is string &&
                       incoming().comment.size() <= 1000 &&
                       incoming().rating is number &&
                       incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Hero Slides & Banners
    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow create: if incoming().name is string && incoming().name.size() <= 100 &&
                       incoming().message is string && incoming().message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter Subscribers
    match /newsletter/{subscriberId} {
      allow create: if incoming().email is string && incoming().email.size() <= 150;
      allow read, delete: if isAdmin();
    }
  }
}
